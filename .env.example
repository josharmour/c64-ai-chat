# Copy to .env and fill in. Only the provider you use needs a key.

# One of: Claude, Gemini, OpenAI, Ollama, LM Studio
C64_PROVIDER=Ollama

# Model id for the active provider. For Ollama: llama3.2, mistral, etc.
# If left blank, the C64 client must pick one with /MODEL before chatting.
C64_MODEL=llama3.2

# --- Cloud providers (only set the one you're using) ---
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# --- Local providers ---
# Ollama running on the Docker host: use host.docker.internal (Windows/Mac/WSL)
# or the host LAN IP. localhost inside a container is the container, not the host.
OLLAMA_URL=host.docker.internal:11434
LMSTUDIO_URL=host.docker.internal:1234
