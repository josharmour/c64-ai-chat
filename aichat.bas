10 REM *** COMMODORE 64 AI CHAT ***
20 REM SWIFTLINK ACIA AT $DE00
30 BA=56832
40 PRINT CHR$(147);"COMMODORE 64 AI CHAT"
45 PRINT:PRINT "SHORTCUTS:"
50 PRINT "  F1 = QUIT"
52 PRINT "  F3 = HELP"
54 PRINT "  F5 = CHANGE MODEL"
56 PRINT "  F7 = CLEAR CHAT":PRINT
60 INPUT "SERVER:PORT";S$
70 IF S$="" THEN S$="10.0.0.10:6464"
80 PRINT:PRINT "CONNECTING TO ";S$;"..."
90 POKE BA+1,0:POKE BA+3,0:POKE BA+2,11
100 A$="ATDT"+S$+CHR$(13):GOSUB 300
120 PRINT:PRINT "F1=QUIT F3=HELP F5=MODEL F7=CLEAR":PRINT
125 POKE 204,0
130 S=PEEK(BA+1):IF(S AND 8)THEN PRINT CHR$(PEEK(BA));
140 GET B$:IF B$="" THEN 130
150 IF B$=CHR$(133) THEN 200
152 IF B$=CHR$(134) THEN A$="/HELP"+CHR$(13):GOSUB 300:GOTO 130
154 IF B$=CHR$(135) THEN A$="/MODEL"+CHR$(13):GOSUB 300:GOTO 130
156 IF B$=CHR$(136) THEN A$="CLEAR"+CHR$(13):GOSUB 300:GOTO 130
160 POKE BA,ASC(B$):GOTO 130
200 PRINT:PRINT "DISCONNECTED.":END
300 FOR I=1 TO LEN(A$):POKE BA,ASC(MID$(A$,I,1)):FOR D=1 TO 5:NEXT D:NEXT I:RETURN
